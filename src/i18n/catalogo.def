// Catálogo de textos de la interfaz del cliente. Cada línea: X(clave, es, en, pt, de, fr).
// Orden de los idiomas: es, en, pt, de, fr (ver textos.h). Los %d / %s se conservan en todas.
// Se agrega una línea por texto nuevo; no hace falta tocar nada más (tests/test_textos.cpp
// verifica que cada clave tenga los cinco idiomas).

// --- Comunes -------------------------------------------------------------------------------
X(UI_F2_ORIGINAL, "F2: interfaz original", "F2: original interface", "F2: interface original",
  "F2: Originaloberfläche", "F2 : interface d'origine")
X(UI_VOLVER, "Volver", "Back", "Voltar", "Zurück", "Retour")

// --- Login ---------------------------------------------------------------------------------
X(LOGIN_SERVIDOR, "Servidor", "Server", "Servidor", "Server", "Serveur")
X(LOGIN_CUENTA, "Cuenta", "Account", "Conta", "Konto", "Compte")
X(LOGIN_CLAVE, "Clave", "Password", "Senha", "Passwort", "Mot de passe")
X(LOGIN_ENTRAR, "Entrar", "Login", "Entrar", "Anmelden", "Connexion")
X(LOGIN_SALIR, "Salir", "Quit", "Sair", "Beenden", "Quitter")
X(LOGIN_CONECTANDO, "Conectando...", "Connecting...", "Conectando...", "Verbinde...", "Connexion...")
X(LOGIN_ERR_CUENTA_EXISTE, "La cuenta ya existe.", "The account already exists.", "A conta já existe.",
  "Das Konto existiert bereits.", "Le compte existe déjà.")
X(LOGIN_ERR_CLAVE, "Usuario o clave incorrectos.", "Wrong account or password.", "Conta ou senha incorretas.",
  "Konto oder Passwort falsch.", "Compte ou mot de passe incorrect.")
X(LOGIN_ERR_EN_USO, "La cuenta ya está en uso.", "The account is already in use.", "A conta já está em uso.",
  "Das Konto wird bereits verwendet.", "Le compte est déjà utilisé.")
X(LOGIN_ERR_RECHAZO, "El servidor rechazó el ingreso.", "The server rejected the login.",
  "O servidor recusou o acesso.", "Der Server hat die Anmeldung abgelehnt.", "Le serveur a refusé la connexion.")
X(LOGIN_ERR_PROTOCOLO, "Versión de protocolo desconocida: ", "Unknown protocol version: ",
  "Versão de protocolo desconhecida: ", "Unbekannte Protokollversion: ", "Version de protocole inconnue : ")

